rules_version = '2';

// Peraturan keselamatan Firestore untuk sistem tempahan homestay.
// Tampal keseluruhan fail ini di: Firebase console → Firestore Database → Rules → Publish

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function adminPath() { return /databases/$(database)/documents/admins/$(myEmail()); }
    function isAdmin() { return signedIn() && exists(adminPath()); }
    function isOwner() { return isAdmin() && get(adminPath()).data.role == 'owner'; }

    // Borang customer: hanya boleh CIPTA tempahan baru dengan medan yang dibenarkan.
    function validPublicBooking(d) {
      return d.keys().hasAll(['name', 'phone', 'guests', 'checkIn', 'checkOut', 'nights', 'estPrice', 'status', 'createdAt'])
        && d.keys().hasOnly(['name', 'phone', 'guests', 'checkIn', 'checkOut', 'nights', 'estPrice', 'status', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.phone is string && d.phone.matches('[0-9+ -]{8,20}')
        && d.guests is int && d.guests >= 1 && d.guests <= 30
        && d.checkIn is string && d.checkIn.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.checkOut is string && d.checkOut.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.checkOut > d.checkIn
        && d.nights is int && d.nights >= 1 && d.nights <= 30
        && d.estPrice is number && d.estPrice >= 0
        && d.status == 'pending'
        && d.createdAt == request.time;
    }

    // Tempahan: orang awam boleh hantar (tetapi TIDAK boleh baca),
    // hanya admin boleh baca / ubah / padam.
    match /bookings/{id} {
      allow create: if isAdmin() || validPublicBooking(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Tarikh yang sudah penuh (tiada maklumat peribadi) — semua orang boleh baca.
    match /nights/{date} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tetapan awam (senarai cuti umum) — semua orang boleh baca.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Senarai admin: hanya OWNER boleh tambah/buang admin.
    // Owner pertama dicipta secara manual di Firebase console.
    match /admins/{email} {
      allow read: if isAdmin() || (signedIn() && myEmail() == email);
      allow create, update: if isOwner() && request.resource.data.role == 'admin';
      allow delete: if isOwner() && email != myEmail();
    }
  }
}
